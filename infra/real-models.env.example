# Explicit opt-in configuration; copy to ignored infra/copilot.env.
# Replace placeholders locally. Do not commit credentials.
# Configure SI_DATABASE_URL explicitly for the same PostgreSQL database in API and worker.
# SI_WORKSPACE_ROOTS=C:/code
SI_COMPATIBLE_BASE_URL=http://127.0.0.1:18790/v1
SI_COMPATIBLE_MODEL=hy3
SI_COMPATIBLE_API_KEY=
SI_COMPATIBLE_CONTEXT_WINDOW=32768
SI_COMPATIBLE_TOOL_CALLING=true
SI_COMPATIBLE_STREAMING=true
SI_COMPATIBLE_VISION=true

SI_EXTRACTION_BACKEND=openai-compatible
SI_EXTRACTION_BASE_URL=http://127.0.0.1:18790/v1
SI_EXTRACTION_MODEL=hy3
SI_EXTRACTION_API_KEY=
SI_SUMMARY_BACKEND=extractive

SI_EMBEDDING_BACKEND=openai-compatible
SI_EMBEDDING_BASE_URL=https://llm-y8gqqw2wrw0p1a96.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
SI_EMBEDDING_API_KEY=
# This endpoint returned 1024 dimensions in the live probe.
SI_EMBEDDING_DIMENSIONS=1024
SI_EMBEDDING_BATCH_SIZE=4

# Jev is intentionally disabled in this baseline.
SI_DECISION_BACKEND=local
# Model context window above is an application limit, not a verified model maximum.
# Docker cannot use the host's loopback tunnel at this URL. See the baseline guide.
