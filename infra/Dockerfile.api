FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE LICENSE-BRAND ./
COPY waku ./waku
COPY skills ./skills
RUN pip install --no-cache-dir uv==0.9.26 && uv sync --frozen --extra copilot --no-dev
COPY alembic.ini ./
COPY infra/migrations ./infra/migrations
ENV PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home copilot
USER copilot
EXPOSE 8000
CMD ["uvicorn", "waku.server.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
