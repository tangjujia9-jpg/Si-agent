# Backend-only example. Copy to infra/copilot.env; never commit populated keys.
SI_DB_PASSWORD=si-local
SI_OPENAI_API_KEY=
SI_OPENAI_BASE_URL=
SI_OPENAI_MODEL=
SI_OPENAI_CONTEXT_WINDOW=8192
SI_OPENAI_TOOL_CALLING=true
SI_ANTHROPIC_API_KEY=
SI_ANTHROPIC_BASE_URL=
SI_ANTHROPIC_MODEL=
SI_ANTHROPIC_CONTEXT_WINDOW=8192
SI_ANTHROPIC_TOOL_CALLING=true
SI_COMPATIBLE_API_KEY=
SI_COMPATIBLE_BASE_URL=
SI_COMPATIBLE_MODEL=
SI_COMPATIBLE_CONTEXT_WINDOW=8192
SI_COMPATIBLE_TOOL_CALLING=true
SI_DECISION_BACKEND=local
SI_JEV_API_KEY=
SI_JEV_MODEL=jev
SI_LANGFUSE_HOST=
SI_LANGFUSE_PUBLIC_KEY=
SI_LANGFUSE_SECRET_KEY=
